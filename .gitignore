# Dependencies and build output
node_modules/
dist/
coverage/
*.tsbuildinfo

# Playwright's output and report (npm run e2e)
test-results/
playwright-report/

# Local env + editor state
.env
.env.*
!.env.example
.secrets/
.vscode/
.idea/
.DS_Store
*.log
tmp/

# Deployment state that never belongs in git: the operator's .env and
# secret files.
/deploy/.env
/deploy/secrets/

# Full-page screenshots of the journeys (npm run e2e:screenshots): a quick
# look at every step without clicking through the app, kept local because
# each run rewrites them all.
docs/anleitung/bilder/full-size/

# VitePress's cache and the built handbooks (npm run handbook). The cut
# pictures (npm run handbook:shots) stay local until the journeys run on
# a school of realistic size; then they are committed.
handbook/.vitepress/cache/
handbook/.vitepress/dist/
handbook/public/bilder/

# The solver's local environment and Python caches.
apps/solver/.venv/
__pycache__/
.pytest_cache/
