# PostgreSQL for school-allocation: the image this repository builds from
# deploy/postgres/Dockerfile, following the v1 line. podman-auto-update
# pulls a new v1 and restarts this unit (README.md, Updates).
[Unit]
Description=school-allocation PostgreSQL

[Container]
Image=ghcr.io/bg-brg-enns/school-allocation-postgres:v1
AutoUpdate=registry
ContainerName=school-allocation-postgres
Network=school-allocation-internal.network
Volume=school-allocation-db.volume:/var/lib/postgresql
# Read-only, with z: on an SELinux host the file is relabelled so the
# container may read it; elsewhere z changes nothing.
Volume=%h/school-allocation/secrets/db-owner-password:/run/secrets/db-owner-password:ro,z
Environment=POSTGRES_DB=school_allocation
Environment=POSTGRES_PASSWORD_FILE=/run/secrets/db-owner-password
# TCP rather than the socket: on first start the image runs a temporary,
# socket-only server while it creates the database. The unit counts as
# started once this passes, so the app's After= waits for a ready database.
HealthCmd=pg_isready -q -h 127.0.0.1 -U postgres -d school_allocation
HealthInterval=5s
HealthTimeout=3s
HealthRetries=12
HealthStartPeriod=30s
Notify=healthy

[Service]
Restart=always
# The first start pulls the image.
TimeoutStartSec=300

[Install]
WantedBy=default.target
