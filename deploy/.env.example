# Copy to ~/school-allocation/.env (chmod 600). The app's unit reads these
# values (deploy/quadlet/school-allocation.container); secrets never go
# here, they are files in secrets/ (see README.md). No release is named:
# the units follow the v1 line of the published images.

# The address browsers use: an origin, or an origin with a path such as
# https://www.example.org/wahl where the app runs under a path of a host it
# shares. The reverse proxy, wherever it runs, terminates TLS for it and
# forwards to the app on this host's 127.0.0.1:3000, the path unchanged.
PUBLIC_URL=https://wahl.example.org

# Where the proxy's connections come from as the app sees them. With rootless
# podman that is not 127.0.0.1 but an address on the app's egress network,
# which podman takes from 10.89.0.0/16 unless configured otherwise. README.md
# explains how to narrow it to that one network.
TRUST_PROXY=10.89.0.0/16

# info, warn or error. Request lines, client addresses and error messages
# are never logged.
LOG_LEVEL=info

# The app registration in the school's tenant: Directory (tenant) ID and
# Application (client) ID from its overview page.
ENTRA_TENANT_ID=00000000-0000-0000-0000-000000000000
ENTRA_CLIENT_ID=00000000-0000-0000-0000-000000000000

# Who becomes a school administrator at their first sign-in: Entra object
# ids or school e-mail addresses, separated by commas. Everyone else gets
# their role in the app, from an administrator.
BOOTSTRAP_ADMINS=admin@schule.example.org

# The Microsoft Graph permissions an administrator consents to for a roster
# refresh from Entra groups, delegated; the app holds none of its own. Unset
# means GroupMember.Read.All, User.ReadBasic.All and Group.Read.All (README.md,
# Roster from Entra groups).
# GRAPH_DELEGATED_SCOPES=GroupMember.Read.All,User.ReadBasic.All,Group.Read.All

# Mail (README.md, Mail): the school's SMTP submission, authenticated. With
# SMTP_HOST unset, mail is off and the notices wait in the outbox. The
# password is the file secrets/smtp-password, never a value here.
# SMTP_HOST=smtp.schule.example.org
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=wahl@schule.example.org
# MAIL_FROM=SchulWahl <wahl@schule.example.org>
# MAIL_REPLY_TO=sekretariat@schule.example.org
